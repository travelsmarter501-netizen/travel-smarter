/* eslint-disable -- review script (not shipped): loose JSON typing on generated plan files is intended. */
// Mixed-date trips (an exceptional day and an ordinary day in the same trip), generated by the real entry point, for before / after
// comparisons of per-day hours.
// Usage: ROOT=$(pwd -W) NODE_OPTIONS=--conditions=react-server npx tsx docs/budapest/tools/bud-mixed-sample.mts out/mixed.json
import { writeFileSync } from "fs";
import { pathToFileURL } from "url";
process.env.NEXT_PUBLIC_PLANNER_PREVIEW_DESTINATIONS ??= "budapest";
const { generateBarcelonaPlanV2 } = await import(pathToFileURL(process.env.ROOT + "/app/smart-planner/barcelona-v2/actions.ts").href);
const { MIXED_CASES } = await import(pathToFileURL(process.env.ROOT + "/docs/budapest/tools/bud-mixed-cases.mts").href);
const out: any[] = [];
for (const c of MIXED_CASES) {
  const input = { destinationId: "budapest", dateMode: "specific", arrivalDate: c.arrival, departureDate: c.departure, interests: c.interests, accommodation: { booked: false } };
  const r: any = await generateBarcelonaPlanV2(input);
  out.push(r.ok ? { id: c.id, why: c.why, c: input, plan: r.data } : { id: c.id, why: c.why, c: input, error: r.error });
}
if (process.argv[2]) writeFileSync(process.argv[2], JSON.stringify(out));
console.log(JSON.stringify({ cases: MIXED_CASES.length, ok: out.filter((x) => x.plan).length, failed: out.filter((x) => !x.plan).map((x) => x.id) }));
