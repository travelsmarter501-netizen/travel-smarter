/* eslint-disable -- review script (not shipped): loose JSON typing on generated plan files is intended. */
// Acceptance test for hours PER DAY (resolveHoursPerDay): mixed trips (an exceptional day and an ordinary day in the same trip),
// generated by the real entry point, then edited through the real edit functions. Every expectation must pass (exit 1 otherwise).
//   A. Independent check of every visit and meal against ITS OWN date's hours, read from the place data (not from the plan).
//   B. Creation, details and adding agree: the hours stored on each stop, its details record and what the add path would use for that
//      day are the same, and equal that date's hours.
//   C. Edits: every start the day offers, a reversed order and a longer first visit keep the day valid by the same independent check,
//      and the "time is tight" warning appears exactly where the independent check finds a problem.
//   D. The seven mixed cases that used to fail (trip-wide hours), checked through the product's own day resolution.
//   E. Restore (no edits / reset) gives the original; save + reopen (JSON round trip) gives the same plan.
// Usage: ROOT=$(pwd -W) NODE_OPTIONS=--conditions=react-server npx tsx docs/budapest/tools/bud-mixed-dates.mts [out.json]
import { writeFileSync } from "fs";
import { pathToFileURL } from "url";
process.env.NEXT_PUBLIC_PLANNER_PREVIEW_DESTINATIONS ??= "budapest";
const imp = async (p: string) => { const x: any = await import(pathToFileURL(process.env.ROOT + p).href); return x.default ?? x; };
const P = await imp("/app/lib/planner/budapest/budapestPlaces.ts");
const T = await imp("/app/lib/planner/tripHours.ts");
const H = await imp("/app/lib/hours.ts");
const G = await imp("/app/lib/planner/plannerTimingGuard.ts");
const TL = await imp("/app/lib/planner/barcelonaV2Timeline.ts");
const M = await imp("/app/lib/planner/budapest/budapestCityModule.ts");
const C = await imp("/app/lib/planner/planCustomizations.ts");
const S = await imp("/docs/budapest/tools/bud-mixed-cases.mts");
const { generateBarcelonaPlanV2 } = await imp("/app/smart-planner/barcelona-v2/actions.ts");

const city = M.BUDAPEST_CITY_MODULE;
const raw = (id: string) => [...P.BUDAPEST_PLACES.attractions, ...P.BUDAPEST_PLACES.experiences, ...P.BUDAPEST_PLACES.foodPlaces, ...P.BUDAPEST_PLACES.shoppingAreas].find((x: any) => x.id === id);
/** That date's planning hours, from the place data (independent of the plan). */
const onDate = (id: string, date: string) => H.planningHoursOf(T.resolveHoursForTrip(raw(id)?.hours, [date]));
const hm = (m: number) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
const fmt = (h: any, weekday: string) => { if (!h) return "none"; if (h.type !== "fixed") return h.type; const r = h.schedule[weekday] ?? []; return r.length ? `${r.map((x: any) => `${x.open}-${x.close}`).join(",")}${h.lastEntry ? ` last ${h.lastEntry}` : ""}` : "CLOSED"; };
let passed = 0, failed = 0;
function expect(label: string, got: string, want: string) {
  const ok = got === want;
  if (ok) passed++; else failed++;
  console.log(`${ok ? "PASS" : "FAIL"}  ${label}: ${got}${ok ? "" : `  (expected ${want})`}`);
}
/** Independent problems of a day: each visit / meal against its own date's hours (opening, closing, last entry, exact departures). */
function independentProblems(day: any): string[] {
  const out: string[] = [];
  const check = (id: string, start: number, end: number, need: number) => {
    const reason = G.checkWindow(onDate(id, day.actualDate), day.weekday, start, end, need);
    if (reason) out.push(`${id} ${hm(start)}-${hm(end)} ${reason}`);
  };
  day.timeline.stops.forEach((w: any, i: number) => check(w.placeId, w.startMinutes, w.endMinutes, day.stops[i].visitDurationMinutes));
  for (const m of day.timeline.meals ?? []) if (m.placeId !== "lunch-break") check(m.placeId, m.startMinutes, m.endMinutes, TL.MEAL_ASSUMED_DURATION_MINUTES[m.mealType]);
  return out;
}
const flaggedStops = (day: any) => day.stops.filter((s: any) => s.warnings.some((w: any) => w.textAr === G.TIMING_WARNING_AR)).map((s: any) => s.id).sort().join(",");
const problemStops = (day: any) => [...new Set(independentProblems(day).map((p) => p.split(" ")[0]).filter((id) => day.stops.some((s: any) => s.id === id)))].sort().join(",");

const plans: Record<string, any> = {};
const out: any[] = [];
for (const c of S.MIXED_CASES) {
  const input = { destinationId: "budapest", dateMode: "specific", arrivalDate: c.arrival, departureDate: c.departure, interests: c.interests, accommodation: { booked: false } };
  const r: any = await generateBarcelonaPlanV2(input);
  if (!r.ok) { expect(`${c.id} generates`, r.error, "ok"); continue; }
  const plan = r.data;
  plans[c.id] = plan;
  out.push({ id: c.id, why: c.why, c: input, plan });
  for (const day of plan.days) {
    const tag = `${c.id} ${day.actualDate} ${day.weekday}`;
    // A. independent check of the generated day.
    expect(`A ${tag}: visits and meals inside that date's hours`, independentProblems(day).join(" | ") || "none", "none");
    // B. stored hours, details and the add path agree with that date.
    const mismatch: string[] = [];
    for (const stop of day.stops) {
      if (stop.visitMode === "outside") continue;
      const want = fmt(onDate(stop.id, day.actualDate), day.weekday);
      const stored = fmt(H.planningHoursOf(stop.hours), day.weekday);
      const details = fmt(H.planningHoursOf(plan.placeDetails?.[stop.id]?.place?.hours), day.weekday);
      if (stored !== want) mismatch.push(`${stop.id} stored ${stored} != ${want}`);
      if (details !== want) mismatch.push(`${stop.id} details ${details} != ${want}`);
    }
    expect(`B ${tag}: stop hours and details = that date's hours`, mismatch.join(" | ") || "same", "same");
    // C. edits.
    const starts: number[] = C.dayValidStarts(city, plan, {}, day.dayNumber);
    const badStarts = starts.filter((m) => {
      const d = C.applyPlanCustomizations(city, plan, { [String(day.dayNumber)]: { startMinutes: m } }).days.find((x: any) => x.dayNumber === day.dayNumber);
      return independentProblems(d).length > 0;
    });
    expect(`C ${tag}: ${starts.length} offered starts all valid by that date's hours`, badStarts.map(hm).join(",") || "all valid", "all valid");
    if (day.stops.length > 1) {
      const reversed = C.applyPlanCustomizations(city, plan, { [String(day.dayNumber)]: { order: [...day.stops].reverse().map((s: any) => s.id) } }).days.find((x: any) => x.dayNumber === day.dayNumber);
      expect(`C ${tag}: reversed order, warnings = real problems`, `warned [${flaggedStops(reversed)}]`, `warned [${problemStops(reversed)}]`);
    }
    const first = day.stops[0];
    if (first) {
      const longer = C.applyPlanCustomizations(city, plan, { [String(day.dayNumber)]: { durations: { [first.id]: first.visitDurationMinutes + 30 } } }).days.find((x: any) => x.dayNumber === day.dayNumber);
      expect(`C ${tag}: first visit +30 min, warnings = real problems`, `warned [${flaggedStops(longer)}]`, `warned [${problemStops(longer)}]`);
    }
  }
  // E. restore and reopen.
  expect(`E ${c.id}: no edits = the original`, C.applyPlanCustomizations(city, plan, {}) === plan ? "original" : "changed", "original");
  const edits = { "1": { startMinutes: C.dayValidStarts(city, plan, {}, 1)[0] ?? 540 } };
  const reset = C.applyPlanChange(city, plan, edits, { kind: "reset", dayNumber: 1 });
  expect(`E ${c.id}: reset day 1 restores the original day`, JSON.stringify(C.applyPlanCustomizations(city, plan, reset).days[0]) === JSON.stringify(plan.days[0]) ? "restored" : "differs", "restored");
  const reopened = JSON.parse(JSON.stringify({ plan, edits }));
  expect(`E ${c.id}: save + reopen gives the same edited plan`, JSON.stringify(C.applyPlanCustomizations(city, reopened.plan, reopened.edits)) === JSON.stringify(C.applyPlanCustomizations(city, plan, edits)) ? "same" : "differs", "same");
}

// D. The seven formerly failing cases, through the product's own day resolution: the stop's stored hours when the place is on that day,
// otherwise the add path for that day (the same per-day resolution as creation, checked in B).
function hoursOnPlanDay(caseId: string, date: string, placeId: string): { text: string; hours: any; weekday: string } {
  const plan = plans[caseId];
  const day = plan.days.find((d: any) => d.actualDate === date);
  let stop = day.stops.find((s: any) => s.id === placeId);
  if (!stop) {
    const edited = C.applyPlanCustomizations(city, plan, { [String(day.dayNumber)]: { order: [placeId, ...day.stops.map((s: any) => s.id)] } }).days.find((d: any) => d.dayNumber === day.dayNumber);
    stop = edited.stops.find((s: any) => s.id === placeId);
  }
  const hours = H.planningHoursOf(stop.hours);
  return { text: fmt(hours, day.weekday), hours, weekday: day.weekday };
}
const MNG = "hungarian-national-gallery", HOM = "house-of-music", CRUISE = "danube-legend-cruise";
const firstDeparture = (x: { text: string }) => x.text.split(",")[0].split(" last ")[0];
expect("D1 gallery Wed 30 Dec 2026 (trip 29 Dec-1 Jan has 31 Dec)", hoursOnPlanDay("M2-A-2026-12-29", "2026-12-30", MNG).text, "10:00-17:30 last 17:00");
expect("D2 gallery Fri 1 Jan 2027 (same trip)", hoursOnPlanDay("M2-A-2026-12-29", "2027-01-01", MNG).text, "12:00-17:30 last 17:00");
const d3 = hoursOnPlanDay("M2-A-2026-12-29", "2026-12-30", MNG);
expect("D3 gallery Wed 30 Dec: a 15:15-17:15 visit is accepted", G.checkWindow(d3.hours, d3.weekday, 915, 1035, 120) ?? "accepted", "accepted");
expect("D4 gallery Mon 28 Dec 2026 (trip also has Mon 4 Jan)", hoursOnPlanDay("M1-culture-2026-12-26", "2026-12-28", MNG).text, "10:00-17:30 last 17:00");
expect("D4b gallery Mon 4 Jan 2027 (same trip, ordinary Monday)", hoursOnPlanDay("M1-culture-2026-12-26", "2027-01-04", MNG).text, "CLOSED");
expect("D4c gallery Thu 31 Dec 2026 (trip 23 Dec-1 Jan)", hoursOnPlanDay("M7-A-2026-12-23", "2026-12-31", MNG).text, "10:00-16:00 last 15:00");
expect("D4d gallery Thu 24 Dec 2026 (same trip)", hoursOnPlanDay("M7-A-2026-12-23", "2026-12-24", MNG).text, "CLOSED");
expect("D5 House of Music Tue 8 Dec 2026 (trip also has Tue 1 Dec)", hoursOnPlanDay("M3-culture-2026-12-01", "2026-12-08", HOM).text, "10:15-17:50 last 16:15");
expect("D5b House of Music Tue 1 Dec 2026 (first Tuesday)", hoursOnPlanDay("M3-culture-2026-12-01", "2026-12-01", HOM).text, "CLOSED");
expect("D6 cruise Thu 31 Dec 2026 (trip also has Thu 24 Dec)", firstDeparture(hoursOnPlanDay("M4-C-2026-12-23", "2026-12-31", CRUISE)), "15:40-16:40");
expect("D6b cruise Thu 24 Dec 2026 (no evening cruise)", hoursOnPlanDay("M4-C-2026-12-23", "2026-12-24", CRUISE).text, "CLOSED");
expect("D7 cruise Mon 16 Nov 2026 (period from 16:20)", firstDeparture(hoursOnPlanDay("M5-C-2026-11-16", "2026-11-16", CRUISE)), "16:20-17:20");
expect("D7b cruise Mon 23 Nov 2026 (next period, 15:40)", firstDeparture(hoursOnPlanDay("M5-C-2026-11-16", "2026-11-23", CRUISE)), "15:40-16:40");
expect("D7c cruise Thu 31 Dec 2026 (year end, published)", firstDeparture(hoursOnPlanDay("M6-C-2026-12-30", "2026-12-31", CRUISE)), "15:40-16:40");
expect("D7d cruise Sat 2 Jan 2027 (no timetable published)", hoursOnPlanDay("M6-C-2026-12-30", "2027-01-02", CRUISE).text, "CLOSED");

// F. Timeline and details agree on 28 Dec, 31 Dec 2026 and 1 Jan 2027 (trip 23 Dec - 1 Jan): the gallery on that day (planned or added
// through the edit path), its stop hours, and the details record the plan returns for it.
for (const [date, want] of [["2026-12-28", "10:00-17:30 last 17:00"], ["2026-12-31", "10:00-16:00 last 15:00"], ["2027-01-01", "12:00-17:30 last 17:00"]]) {
  const plan = plans["M7-A-2026-12-23"];
  const day = plan.days.find((d: any) => d.actualDate === date);
  const has = day.stops.some((s: any) => s.id === MNG);
  const edited = has ? plan : C.applyPlanCustomizations(city, plan, { [String(day.dayNumber)]: { order: [MNG, ...day.stops.map((s: any) => s.id)] } });
  const eDay = edited.days.find((d: any) => d.dayNumber === day.dayNumber);
  const stopText = fmt(H.planningHoursOf(eDay.stops.find((s: any) => s.id === MNG).hours), day.weekday);
  const detailsText = fmt(H.planningHoursOf(edited.placeDetails[MNG].place.hours), day.weekday);
  const w = eDay.timeline.stops.find((x: any) => x.placeId === MNG);
  const insideOwnDate = G.checkWindow(onDate(MNG, date), day.weekday, w.startMinutes, w.endMinutes, eDay.stops.find((s: any) => s.id === MNG).visitDurationMinutes) ?? "inside";
  expect(`F gallery ${date} (${has ? "planned" : "added"}): stop / details / visit ${hm(w.startMinutes)}-${hm(w.endMinutes)}`, `${stopText} / ${detailsText} / ${insideOwnDate}`, `${want} / ${want} / inside`);
}

if (process.argv[2]) writeFileSync(process.argv[2], JSON.stringify(out));
console.log(`\n${passed} pass, ${failed} fail`);
process.exit(failed ? 1 : 0);
